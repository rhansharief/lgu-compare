---
import { readdirSync, readFileSync } from 'node:fs';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  const dir = 'public/data/contractor';
  return readdirSync(dir).flatMap((f) =>
    Object.values(JSON.parse(readFileSync(`${dir}/${f}`, 'utf8'))).map((c: any) => ({ params: { id: c.id }, props: { name: c.name } })),
  );
}
const { name } = Astro.props as { name: string };
---

<Base title={name} nav="contractor" description="National DPWH infrastructure contracts won by a contractor, and the cities and municipalities where it worked.">
  <div class="page-head"><h1 id="c-name">{name}</h1></div>
  <p class="subline" id="c-sub"></p>
  <p class="faint small" id="c-aliases"></p>
  <div id="c-body">
    <div class="grid tiles section" id="c-tiles"></div>
    <div class="grid two section">
      <section class="card"><div class="card-head"><h2>Where it worked</h2><p class="muted small">Cities and municipalities, by amount</p></div><div id="c-lgus"></div></section>
      <section class="card"><div class="card-head"><h2>By budget year and category</h2></div><div id="c-years"></div></section>
    </div>
    <section class="card section"><div class="card-head"><h2>Projects</h2></div><div id="c-projects"></div></section>
  </div>
  <p class="faint small" style="margin-top:14px">
    Amounts are DPWH contract costs as listed in the Transparency Portal. A joint-venture contract is split equally between its partners.
    Winning contracts is not evidence of wrongdoing. See <a href="/about/">method &amp; data</a>.
  </p>
  <script>
    import { initContractorPage } from '../../lib/client/contractor-page.ts';
    initContractorPage().catch((e) => { console.error(e); document.getElementById('c-name')!.textContent = 'Could not load data. Please reload.'; });
  </script>
</Base>
