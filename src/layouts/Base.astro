---
import '../styles/global.css';
import { buildIndex } from '../lib/build-data.ts';

const sources = buildIndex.sources;

interface Props {
  title: string;
  description?: string;
  nav?: 'home' | 'compare' | 'about' | 'lgu' | 'contractor';
}
const { title, description = 'Does national infrastructure (DPWH) money go where it is needed, and who is getting it? Compare any Philippine city or municipality with similar LGUs.', nav } = Astro.props;
const fullTitle = title === 'Infra Money Tracker' ? title : `${title} · Infra Money Tracker`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Infra <span>Money</span> Tracker</a>
        <div class="search" data-search>
          <input
            type="search"
            placeholder="Find a city or municipality…"
            aria-label="Find a city or municipality"
            role="combobox"
            aria-expanded="false"
            aria-controls="search-list"
            aria-autocomplete="list"
            autocomplete="off"
          />
          <ul id="search-list" role="listbox" hidden></ul>
        </div>
        <nav class="site-nav" aria-label="Main">
          <a href="/compare/" aria-current={nav === 'compare' ? 'page' : undefined}>Compare</a>
          <a href="/about/" aria-current={nav === 'about' ? 'page' : undefined}>Method &amp; data</a>
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>◐</button>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Data from BetterGov.PH APIs and PSA. Not affiliated.</p>
        <p>
          Sources: <a href={sources.dpwh.url}>DPWH Transparency Portal via BetterGov.PH</a> (retrieved {sources.dpwh.fetched}) ·
          <a href={sources.psgc.url}>PSA PSGC Q2 2024, population 2024</a> ·
          <a href={sources.poverty.url}>PSA poverty incidence 2018–2023</a> (retrieved {sources.poverty.fetched})
        </p>
        <p>
          National DPWH infrastructure projects only, not LGU-funded spending. Amounts are contract costs
          as listed in the DPWH Transparency Portal. A personal, non-profit civic-tech project. See <a href="/about/">method &amp; data</a>.
        </p>
      </div>
    </footer>
    <script>
      import { initSearch } from '../lib/client/search.ts';
      initSearch();
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        window.dispatchEvent(new Event('themechange'));
      });
    </script>
  </body>
</html>
